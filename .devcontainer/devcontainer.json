{
  "name": "sus-lakehouse",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "mtxr.sqltools",
        "regadas.sqltools-trino-driver",
        "mtxr.sqltools-driver-pg",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "sqltools.connections": [
          {
            "name": "Trino local",
            "driver": "Trino",
            "host": "localhost",
            "port": 8081,
            "catalog": "iceberg",
            "username": "dev"
          },
          {
            "name": "Postgres OLTP",
            "driver": "PostgreSQL",
            "server": "localhost",
            "port": 5433,
            "database": "oltp",
            "username": "oltp",
            "password": "oltp"
          }
        ]
      }
    }
  },
  "forwardPorts": [8080, 8081, 9000, 9001, 5433]
}
